# MediStock Cloud — environment configuration example.
# Copy to ".env" and fill in your own values. NEVER commit a real .env file.

APP_NAME="MediStock Cloud"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_CURRENCY=USD
APP_TRIAL_DAYS=14
APP_GRACE_DAYS=7
APP_INSTALLED=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medistock_cloud
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Payment gateway (optional — leave blank to use manual payment recording).
# Payments are only marked successful after verified gateway confirmation.
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
